{
  "name": "lumina-story",
  "version": "0.2.0-bete",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "dev:local-paid-test": "next dev --webpack -H 0.0.0.0 -p 3000",
    "build": "next build --webpack && node scripts/sanitize-standalone-artifact.mjs && node scripts/check-standalone-artifact.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "tsx scripts/run-postgres-tests.ts",
    "test:all": "npm test && npm run test:postgres",
    "auth:grant-system-admin": "tsx scripts/auth-grant-system-admin.ts",
    "auth:revoke-system-admin": "tsx scripts/auth-revoke-system-admin.ts",
    "legacy:prisma:generate": "prisma generate",
    "legacy:prisma:validate": "prisma validate",
    "legacy:prisma:migrate:dev": "prisma migrate dev",
    "legacy:prisma:studio": "prisma studio",
    "legacy:prisma:seed": "prisma db seed",
    "db:legacy:dry-run": "tsx scripts/import-legacy-file-data.ts --dry-run",
    "db:legacy:import": "tsx scripts/import-legacy-file-data.ts --apply",
    "db:legacy:verify": "tsx scripts/import-legacy-file-data.ts --verify",
    "db:up": "docker compose up -d postgres postgres-test",
    "architecture:check": "node scripts/check-remote-architecture.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "ali-oss": "^6.23.0",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/ali-oss": "^6.23.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "1.62.1",
    "prisma": "6.19.3",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
