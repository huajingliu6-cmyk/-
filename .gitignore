# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local mock playable MP4 (dev only; never commit real videos)
/data/mock/**
!/data/mock/.gitkeep
!/data/mock/README.md

# local generation task records
/data/generations/**
!/data/generations/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local canvas data (keep folder, ignore saved JSON)
/data/canvases/*.json

# legacy tldraw snapshots (keep until owner confirms deletion)
/data/canvases-legacy/*.json
!/data/canvases-legacy/LEGACY.md
!/data/canvases-legacy/.gitkeep

# local workflow data (dev-only JSON store)
/data/workflows/*.json
/data/workflows/*.tmp
!/data/workflows/.gitkeep
/data/workflows/*.bak.json

# local auth users (password hashes)
/data/users.json
/data/users.json.*

# generation API configs (may contain keys)
/data/generation-api-configs.json
/data/generation-api-configs.json.*

# local uploaded assets (dev-only file store; not for Vercel production)
/data/assets/**
!/data/assets/.gitkeep

# mock / transfer intermediate videos (dev-only; never commit MP4)
/data/generated-videos/**
!/data/generated-videos/.gitkeep
