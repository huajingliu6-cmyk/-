# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local canvas data (keep folder, ignore saved JSON)
/data/canvases/*.json

# legacy tldraw snapshots (keep until owner confirms deletion)
/data/canvases-legacy/*.json
!/data/canvases-legacy/LEGACY.md
!/data/canvases-legacy/.gitkeep

# local workflow data (dev-only JSON store)
/data/workflows/*.json
!/data/workflows/.gitkeep
