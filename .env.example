# 视频生成 Provider：mock | aliyun-wan27
# 默认必须为 mock，避免误触发付费调用
VIDEO_PROVIDER=mock

# 真实付费生成总开关。默认 false。
# 即使 VIDEO_PROVIDER=aliyun-wan27，未显式打开也不允许提交真实任务。
ALLOW_PAID_GENERATION=false

# 视频参考图预检（方舟 VLM）。可只配「管理 API → 视频参考图预检」；
# 未配槽位时会复用 video-shot 的方舟 URL+Key。模型须账号已开通。
# VIDEO_REF_PRECHECK_MODEL=doubao-seed-2-0-lite-260215
# VIDEO_REF_PRECHECK_API_URL=
# VIDEO_REF_PRECHECK_API_KEY=
# VIDEO_REF_PRECHECK_PROVIDER=http

# 移动 SD2 / VideoFee 平台（设计「人物校验」与真人认证门禁；可与方舟视频镜头并存）
# 管理 API →「移动 SD2 平台」，或：
# SD2_PLATFORM_API_URL=http://36.212.37.227:3099
# SD2_PLATFORM_API_KEY=
# SD2_PLATFORM_PROVIDER=http
# 规则：人物参考图须 SD 认证 active 后，才可作为方舟参考图生视频。

# 视频镜头 HTTP 方言（可选强制）：ark | sd2 | openai-videos | legacy-sync
# 若视频镜头本身就走 SD2（整站不用方舟），可：
# VIDEO_SHOT_HTTP_DIALECT=sd2
# VIDEO_SHOT_API_URL=平台根地址（或 …/v1/video/generations）
# VIDEO_SHOT_MODEL=doubao-seedance-2.0
# VIDEO_SHOT_HTTP_DIALECT=
# VIDEO_SHOT_API_URL=
# VIDEO_SHOT_PROVIDER=http

# 本地可播放 Mock 视频（可选）。默认读取 data/mock/mock-video.mp4
# 文件不进 Git；详见 docs/mock-video-setup.md
# MOCK_VIDEO_FILE=

# 本地音色库目录（可选）。默认：用户桌面/本地音频库
# 选择音色时临时读取此目录下的音频文件；角色 voiceId 与视频生成绑定。
# LOCAL_VOICE_LIBRARY_DIR=

# 阿里云百炼（DashScope）——仅服务端读取，切勿使用 NEXT_PUBLIC_ 前缀
DASHSCOPE_API_KEY=
# 业务空间 ID，用于构造专属 Endpoint
DASHSCOPE_WORKSPACE_ID=
# 地域：cn-beijing（华北2）或 ap-southeast-1（新加坡）
# Workspace、API Key、Endpoint 必须属于同一地域
DASHSCOPE_REGION=cn-beijing

# 万相 2.7 模型 ID（服务端使用，客户端不可覆盖）
WAN_T2V_MODEL_ID=wan2.7-t2v-2026-06-12
WAN_R2V_MODEL_ID=wan2.7-r2v-2026-06-12

# 真实 Provider 结果下载域名白名单（仅服务端；浏览器不可读）
# 逗号分隔。普通主机名为精确匹配；以 . 或 *. 开头为后缀规则（明确边界）。
# 官方文档不保证固定 OSS 域名，默认留空 → 真实结果转存被阻止。
# 首次人工确认结果域名后由管理员填写，例如：
# WAN_RESULT_ALLOWED_HOSTS=dashscope-result-sh.oss-accelerate.aliyuncs.com
WAN_RESULT_ALLOWED_HOSTS=

# —— 本机一次性付费测试闸门（仅服务端；默认全部关闭）——
# 禁止 NEXT_PUBLIC_ 前缀。禁止通过 query / LocalStorage 开启。
# 仅 NODE_ENV=development 且下列开关全部人工就绪时才可能 Arm。
# Agent / 测试 / 构建不得填写真实 Token 或开启付费。
WAN_LOCAL_PAID_TEST_MODE=false
WAN_LOCAL_PAID_TEST_TOKEN=
# 价格人工确认日期（YYYY-MM-DD，必须为服务端本地当天）
WAN_TEST_PRICE_CONFIRMED_ON=
# 人工确认的最大费用上限（元）；硬安全上限见代码常量（≤10）
WAN_TEST_MAX_COST_CNY=
# 第一版只允许 1
WAN_TEST_MAX_TASKS=1

# ���� ����/�ı����ɣ�������ˣ���ֹ NEXT_PUBLIC_������
# mock | dashscope��Ĭ�� mock�������󴥷�����
TEXT_LLM_PROVIDER=mock
# DashScope OpenAI-compatible �ı�ģ�� ID�������ӳ�䣬�ͻ���ֻ�� publicKey��
TEXT_LLM_MODEL_ID=qwen-plus
# ��ѡ���Ǽ���ģʽ Base URL
# DASHSCOPE_COMPATIBLE_BASE_URL=
# DEV ���Ի��ֶ��ۣ�ÿ 1k token������ʽ���� TODO
TEXT_POINTS_PER_1K_INPUT=1
TEXT_POINTS_PER_1K_OUTPUT=2
TEXT_CREDITS_DEV_BALANCE=10000
TEXT_GEN_RATE_LIMIT_PER_MINUTE=10

# ---- Persistence (Batch A/B0-B1: PostgreSQL + object storage) ----
# Runtime default remains file JSON until domains switch.
# Production must use postgres + aliyun_oss (never file/local).
# Batch B0-B1: set PERSISTENCE_DRIVER=postgres to use PostgreSQL for project list/create/get/patch.
PERSISTENCE_DRIVER=file
DATABASE_URL=postgresql://ic_dev:ic_dev_password@localhost:5432/infinite_canvas?schema=public
TEST_DATABASE_URL=postgresql://ic_test:ic_test_password@localhost:5433/infinite_canvas_test?schema=public

# Optional: override legacy JSON / local file root (tests set this to a temp dir).
# APP_DATA_DIR=
# DATA_ROOT=

# AI 配置中心 API Key 落盘加密主密钥（仅服务端）。
# Base64 解码后必须恰好 32 字节。缺失时：可读非 Secret 配置，但不能保存新 Key。
# 生成示例（勿提交真实值）：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required to save/edit API Keys in Admin AI config (Base64-encoded 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AI_CONFIG_ENCRYPTION_KEY=

FILE_STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=data/object-storage

# ---- Remote-only Web + Go runtime ----
# Target deployment forbids browser/server local persistence. Workflow is the
# first migrated domain; enable this only where every required domain is ready.
REMOTE_DATA_ONLY=true
GO_BACKEND_INTERNAL_URL=http://api:8080
INTERNAL_API_TOKEN=
# Development/test cache only. Leave unset in production.
# SSDB_ADDRESS=ssdb:8888
# SSDB_PASSWORD=

# Go Blob storage. Local compatibility defaults to postgres. Remote production
# must use remotefile so PostgreSQL stores metadata only and binary bytes live
# in the dedicated internal blobstore volume.
BLOB_STORAGE_DRIVER=postgres
BLOBSTORE_INTERNAL_URL=http://blobstore:8090
BLOBSTORE_INTERNAL_TOKEN=

# Production OSS (server-only; never NEXT_PUBLIC_*)
# ALIYUN_OSS_REGION=oss-cn-hangzhou
# ALIYUN_OSS_ENDPOINT=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_ROLE_ARN=
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_SECURITY_TOKEN=
# ALIYUN_OSS_ALLOW_DEFAULT_CREDENTIAL_CHAIN=1
